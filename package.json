{
  "name": "open-parcels-rules",
  "license": "Unlicense",
  "version": "2.0.0-dev.11",
  "description": "Collectively maintained parcel-tracking knowledge (tracking-number formats, carrier status tables, delivery-date phrases, shipping-email rules) and a TypeScript engine that reads it.",
  "homepage": "https://github.com/open-parcels/open-parcels-rules#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-parcels/open-parcels-rules.git"
  },
  "bugs": {
    "url": "https://github.com/open-parcels/open-parcels-rules/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundle.json": "./dist/bundle.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.ts",
    "build": "node scripts/clean.ts && tsc -p tsconfig.build.json && node scripts/bundle.ts",
    "generate": "node scripts/generate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "python": "node scripts/python-vectors.ts",
    "gate": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test && npm run python"
  },
  "allowScripts": {},
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
